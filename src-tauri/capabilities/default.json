{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "store:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-unregister-all",
    "clipboard-manager:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "sql:default",
    "sql:allow-execute",
    "autostart:default",
    "updater:default",
    "process:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://github.com/**" },
        { "url": "https://api.github.com/**" },
        { "url": "https://objects.githubusercontent.com/**" },
        { "url": "https://release-assets.githubusercontent.com/**" },
        { "url": "https://translate.googleapis.com/**" },
        { "url": "https://translate.google.com/**" },
        { "url": "https://transmart.qq.com/**" },
        { "url": "https://yi.qq.com/**" },
        { "url": "https://www2.deepl.com/**" },
        { "url": "https://api-free.deepl.com/**" },
        { "url": "https://api.deepl.com/**" },
        { "url": "https://api.deepl-pro.com/**" },
        { "url": "https://edge.microsoft.com/**" },
        { "url": "https://api-edge.cognitive.microsofttranslator.com/**" },
        { "url": "https://translate.yandex.net/**" },
        { "url": "https://api.openai.com/**" },
        { "url": "https://api.anthropic.com/**" },
        { "url": "https://*.anthropic.com/**" },
        { "url": "https://api.deepseek.com/**" },
        { "url": "https://*.deepseek.com/**" },
        { "url": "https://api.moonshot.cn/**" },
        { "url": "https://*.moonshot.cn/**" },
        { "url": "https://dashscope.aliyuncs.com/**" },
        { "url": "https://*.aliyuncs.com/**" },
        { "url": "https://*.openai.azure.com/**" },
        { "url": "https://*.openrouter.ai/**" },
        { "url": "https://openrouter.ai/**" },
        { "url": "https://api.siliconflow.cn/**" },
        { "url": "https://*.siliconflow.cn/**" },
        { "url": "https://api.groq.com/**" },
        { "url": "https://*.groq.com/**" },
        { "url": "https://generativelanguage.googleapis.com/**" },
        { "url": "https://*.googleapis.com/**" },
        { "url": "https://**" },
        { "url": "http://**" },
        { "url": "https://mt.cn-hangzhou.aliyuncs.com/**" },
        { "url": "http://mt.cn-hangzhou.aliyuncs.com/**" },
        { "url": "https://tmt.tencentcloudapi.com/**" },
        { "url": "https://open.volcengineapi.com/**" },
        { "url": "https://api.niutrans.com/**" },
