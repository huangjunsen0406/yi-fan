{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "\u6613\u7ffb",
  "version": "0.2.5",
  "identifier": "com.junsen.yi-fan",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "\u6613\u7ffb",
        "width": 800,
        "height": 600,
        "minWidth": 480,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 16
        },
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https: http://localhost:* https://localhost:* http://127.0.0.1:*; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "copyright": "MIT",
    "shortDescription": "\u6613\u7ffb - \u8f7b\u91cf\u7ffb\u8bd1\u5de5\u5177",
    "longDescription": "\u57fa\u4e8e Tauri 2 + Vue 3 \u7684\u8de8\u5e73\u53f0\u8f7b\u91cf\u7ffb\u8bd1\u5de5\u5177\uff0c\u96c6\u6210\u591a\u79cd\u7ffb\u8bd1\u5f15\u64ce",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "bundleName": "\u6613\u7ffb",
      "signingIdentity": null
    },
    "linux": {
      "deb": {
        "depends": [
          "libxdo-dev",
          "libxcb1",
          "libxrandr2"
        ]
      },
      "rpm": {
        "depends": [
          "libxdo",
          "libxcb",
          "libXrandr"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/huangjunsen0406/yi-fan/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1OTczQTA2QkM0NDZDQzEKUldUQmJFUzhCanFYSlgxWkVjZFlnSEtLWUtoR3ZmSk5xVEx5cEFUTHBUWkgzYVFNUTFlV3YvUXAK"
    }
  }
}
